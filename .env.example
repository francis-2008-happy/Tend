# Copy this file to .env.local and fill in the values.
# .env.local is never committed. Variables starting with NEXT_PUBLIC_ are
# visible on the phone; everything else stays on the server.

# --- Supabase (phase 0) ---------------------------------------------------
# Supabase dashboard > Project Settings > API (or `npm run db:start` locally)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses Row Level Security: use only in trusted server code.
SUPABASE_SECRET_KEY=
# Used by the Supabase CLI to link this folder to your project
SUPABASE_PROJECT_REF=

# --- App ------------------------------------------------------------------
# Used for invite links and magic-link redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to true once a custom SMTP sender and Tend's email templates are live
# (supabase/config.toml). Shows the 6-digit code box on the login screen.
NEXT_PUBLIC_EMAIL_CODES_ENABLED=false

# --- Google sign-in (phase 1, optional) ------------------------------------
# Configured inside Supabase Auth; listed here for reference
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Web Push (phase 4) ---------------------------------------------------
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com

# --- Paystack (phase 11, test mode until launch) ---------------------------
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- Monitoring and analytics (phase 12) ----------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=
